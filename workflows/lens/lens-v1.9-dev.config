params.lens$somatic$som_vars_to_union_som_vars$vcf_merging_tool_parameters = "['jacquard_merge': '--include_format_tags=\"GT,AF,AU,CU,GU,TU,TAR,TIR,FREQ,VAF,DP,AD\"']"

