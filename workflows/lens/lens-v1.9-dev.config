# Somatic Variant Calling
params.lens$somatic$alns_to_som_vars$som_var_caller = "strelka2,mutect2"
params.lens$somatic$alns_to_som_vars$som_var_caller_parameters = "['gatk_filter_mutect_calls_suffix': '.gfilt']"
